<div class="min-vh-100 d-flex align-items-center justify-content-center px-3" style="padding-top: 80px; padding-bottom: 30px;">
  <div class="col-12 col-sm-10 col-md-8 col-lg-6 col-xl-5">

    <div class="card border-dark border-3 shadow">
      <div class="card-header bg-warning border-dark text-center py-3">
        <h2 class="fw-bold mb-0">🔐 Forgot your password?</h2>
      </div>

      <div class="card-body p-4">
        <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
          <%= f.error_notification %>

          <!-- Email -->
          <div class="mb-3">
            <label class="form-label fw-bold">Email</label>
            <%= f.input :email,
                        required: true,
                        autofocus: true,
                        label: false,
                        input_html: {
                          autocomplete: "email",
                          class: "form-control border-dark border-2 py-2"
                        } %>
          </div>

          <!-- Boutons -->
          <div class="d-grid gap-2 mt-4">
            <%= f.button :submit, "Reset password", class: "btn btn-warning border-dark border-2 fw-bold py-2" %>
            <%= link_to "Login", new_user_session_path, class: "btn btn-outline-dark fw-bold w-100" %>
          </div>

        <% end %>
      </div>
    </div>

    <!-- Back link -->
    <div class="text-center mt-4">
      <%= link_to "← Back to Home", root_path, class: "btn btn-outline-dark fw-bold" %>
    </div>

  </div>
</div>
